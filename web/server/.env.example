# Battleship Server Environment Variables
# Copy this file to .env and fill in the values

# Port to run the server on (default: 3001)
PORT=3001

# Comma-separated list of allowed CORS origins
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# For production, add your Firebase hosting URL:
# ALLOWED_ORIGINS=https://your-app.web.app,https://your-app.firebaseapp.com

# Node environment (set automatically by npm scripts)
# NODE_ENV=development

# MongoDB connection URI (optional — server runs in guest-only mode without it)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/battleships

# Firebase Admin SDK — set ONE of these for Google Sign-In support:
# Option 1: JSON string of the service account key
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option 2: Path to the service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
